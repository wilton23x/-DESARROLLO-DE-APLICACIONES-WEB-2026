import csv
from services.producto_service import insertar_producto

def cargar_csv():
    try:
        with open("datos.csv", newline="", encoding="utf-8") as archivo:
            lector = csv.DictReader(archivo)

            for fila in lector:
                nombre = fila["nombre"]
                autor = fila.get("autor", "")
                cantidad = int(fila.get("cantidad", 1))
                precio = float(fila["precio"])

                insertar_producto(nombre, autor, cantidad, precio)

        print("CSV cargado correctamente")

    except Exception as e:
        print("Error al cargar CSV:", e)